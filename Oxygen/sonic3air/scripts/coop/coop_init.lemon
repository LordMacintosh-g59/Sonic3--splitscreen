// ============================================================
//  NEW GAME STARTUP
// ============================================================

function void DataSelect.sharedNewGameStartup()
{
	coop.finished.p1 = 0
	coop.finished.p2 = 0

	base.DataSelect.sharedNewGameStartup()

#if STANDALONE
	if (coop.isActive())
	{
		debugLog("Co-op mode ACTIVE: P1=" + coop.character.p1 + " P2=" + coop.character.p2)
	}
#endif
}
