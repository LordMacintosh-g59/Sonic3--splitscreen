/*
*	Sonic 3 & Knuckles Co-op Mod
*	coop_charselect.lemon  —  character selection for both players
*
*	In co-op mode each player picks a character on the Data Select
*	screen, independently of the save slot:
*	  - controller 1 up/down cycles P1's character
*	  - controller 2 up/down cycles P2's character
*	  (Sonic, Tails, Knuckles each; any pair is allowed)
*	The choice is shown at the bottom of the screen and applies to
*	"No Save", new save slots and continued save slots alike.
*	Save slots themselves always store "Sonic & Tails" in co-op.
*
*	Published under the GNU GPLv3 open source software license.
*/


constant u8 COOP_MAX_CHAR = 2		// CHARACTER_SONIC = 0, CHARACTER_TAILS = 1, CHARACTER_KNUCKLES = 2

constant string COOP_SELECT_FONT = "oxyfont_regular:gradient:outline(0x000000ff,1,false):shadow(1,1,0.5f,0.8f)"


function u8 coop.cycleCharacter(u8 character, u8 pressed)
{
	if (pressed & CONTROL_UP)
	{
		playSound(SFX_CLICK)
		return (character < COOP_MAX_CHAR) ? (character + 1) : CHARACTER_SONIC
	}
	if (pressed & CONTROL_DOWN)
	{
		playSound(SFX_CLICK)
		return (character > CHARACTER_SONIC) ? (character - 1) : COOP_MAX_CHAR
	}
	return character
}

function string coop.characterName(u8 character)
{
	if (character == CHARACTER_TAILS)
		return "TAILS"
	if (character == CHARACTER_KNUCKLES)
		return "KNUCKLES"
	return "SONIC"
}

function string coop.deviceName(u8 deviceFlags)
{
	if (deviceFlags == 3)
		return "CONTROLE + TECLADO"
	if (deviceFlags == 2)
		return "CONTROLE"
	if (deviceFlags == 1)
		return "TECLADO"
	return "NENHUM"
}

// Data Select character icon (animation sprite) for the current pair
function u8 coop.pairIconSprite()
{
	if (coop.character.p1 == CHARACTER_SONIC && coop.character.p2 == CHARACTER_TAILS)
		return 4		// Sonic & Tails
	if (coop.character.p1 == CHARACTER_KNUCKLES && coop.character.p2 == CHARACTER_TAILS)
		return 8		// Knuckles & Tails
	return 5 + coop.character.p1		// 5 = Sonic, 6 = Tails, 7 = Knuckles
}

// True if the highlighted save slot is a completed game, where controller 1 up/down picks the zone instead
function bool coop.isCompletedSlotSelected()
{
	if (dataselect.slot_selected == 0)
		return false
	u32 slot = 0xffffe6ac + u32(dataselect.slot_selected - 1) * 10
	return ((u8[slot] & 0x80) == 0) && ((u8[slot] & 0x03) != 0)
}

// Called once per Data Select frame
function void coop.updateDataSelect()
{
	if (!coop.isCompletedSlotSelected())
	{
		coop.character.p1 = coop.cycleCharacter(coop.character.p1, control.pad1.pressed)
	}
	coop.character.p2 = coop.cycleCharacter(coop.character.p2, control.pad2.pressed)

#if STANDALONE
	// L on any device (key E / LB) swaps which player uses the gamepad and which one the keyboard.
	// Checked per simulation frame (bit 0x0400 = L), as "Input.buttonPressed" can stay set for several simulation frames.
	// After a swap the pads read the other devices, so L would look newly pressed again: wait until it's released everywhere.
	bool pressedL = false
	bool heldL = false
	for (u8 pad = 0; pad < 2; ++pad)
	{
		if (Input.getController(pad) & 0x0400)
		{
			heldL = true
			if (!(Input.getControllerPrevious(pad) & 0x0400))
				pressedL = true
		}
	}
	if (!heldL)
		coop.deviceSwapLatch = false
	if (pressedL && !coop.deviceSwapLatch)
	{
		coop.deviceSwapLatch = true
		Game.swapCoopPlayerDevices()
		playSound(SFX_CLICK)
	}

	s32 py = getScreenHeight() - 34
	Renderer.drawText(COOP_SELECT_FONT, 8, py,      "P1: " + coop.deviceName(Game.getCoopPlayerDevices(0)), 0x80c0ffff, 4, 0, 0xf000, false, true)
	Renderer.drawText(COOP_SELECT_FONT, 8, py + 12, coop.characterName(coop.character.p1), 0xffffffff, 4, 0, 0xf000, false, true)
	Renderer.drawText(COOP_SELECT_FONT, getScreenWidth() - 8, py,      "P2: " + coop.deviceName(Game.getCoopPlayerDevices(1)), 0xffc060ff, 6, 0, 0xf000, false, true)
	Renderer.drawText(COOP_SELECT_FONT, getScreenWidth() - 8, py + 12, coop.characterName(coop.character.p2), 0xffffffff, 6, 0, 0xf000, false, true)
	Renderer.drawText(COOP_SELECT_FONT, 8, py - 24, "Cima/baixo: personagem", 0xc0c0c0ff, 4, 0, 0xf000, false, true)
	Renderer.drawText(COOP_SELECT_FONT, 8, py - 12, "L (tecla E / LB): trocar controle e teclado", 0xc0c0c0ff, 4, 0, 0xf000, false, true)
#endif
}


// ============================================================
//  Data Select overrides
//  The base functions keep handling slots, zones and starting the
//  game; in co-op they always see "Sonic & Tails" (two character
//  slots), and the character cycling is done by coop.updateDataSelect.
// ============================================================

// Character cycling of the base game: disabled in co-op
function void fn00d6d0()
{
	if (!coop.isActive())
	{
		base.fn00d6d0()
	}
}

// "No Save" icon and start
function void fn00d30c()
{
	if (!coop.isActive())
	{
		base.fn00d30c()
		return
	}

	dataselect.nosave_characters = CHARS_SONIC_AND_TAILS
	base.fn00d30c()
	objA0.animation.sprite = coop.pairIconSprite()
}

// Save slot icon, new game and continue
function void fn00d42c()
{
	if (!coop.isActive())
	{
		base.fn00d42c()
		return
	}

	// New games get stored as "Sonic & Tails"; used slots keep their stored value
	u32 slot = u32[A0 + 0x30]
	if (u8[slot] & 0x80)
	{
		u16[A0 + 0x34] = CHARS_SONIC_AND_TAILS
	}

	base.fn00d42c()
	objA0.animation.sprite = coop.pairIconSprite()
}


// ============================================================
//  SetGlobalCharacters OVERRIDE
//  Co-op always needs both character slots; their actual characters
//  come from coop.character.p1/p2 (see InitializeGameCharacters).
// ============================================================

function void SetGlobalCharacters()
{
	if (!coop.isActive())
	{
		base.SetGlobalCharacters()
		return
	}

	global.characters = CHARS_SONIC_AND_TAILS
	useKnucklesAndTails = false
}


// ============================================================
//  GAME_QUERIES OVERRIDES
// ============================================================

function u8 getMainCharacter()
{
	if (coop.isActive())
	{
		return coop.character.p1
	}
	return base.getMainCharacter()
}

function u8 getSecondCharacter()
{
	if (coop.isActive())
	{
		return coop.character.p2
	}
	return base.getSecondCharacter()
}

function u8 getNumPlayers()
{
	if (coop.isActive())
	{
		return 2
	}
	return base.getNumPlayers()
}
